# Produção — copie para infra/.env NA VPS, preencha e proteja:  cp prod.env.example .env && chmod 600 .env
# Nunca versione o .env nem cole estes valores em chat, e-mail ou issue.
# Segredos novos:  openssl rand -base64 32

# ---- Site ----------------------------------------------------------------------------------------------
# Endereço público. Na prévia (antes de trocar o domínio principal): https://novo.<domínio>.
SITE_URL=https://zonasulurgente.com.br
# "production" libera o Google. Qualquer outro valor (ex.: staging) bloqueia a indexação — use na prévia.
SITE_ENV=staging
WHATSAPP_URL=
REPORT_WHATSAPP_URL=
ADSENSE_CLIENT=

# ---- Segredos ------------------------------------------------------------------------------------------
DB_PASSWORD=
# AES-256 dos segredos do 2FA. Trocar depois invalida os 2FA cadastrados — guarde no gerenciador de senhas.
TOTP_ENCRYPTION_KEY=
# Mesmo valor para o site e a API (revalidação depois de publicar). Mínimo 32 caracteres.
REVALIDATE_SECRET=

# ---- Fotos: Cloudflare R2 ------------------------------------------------------------------------------
# Bucket com domínio próprio (ex.: media.<domínio>) e um token de API do R2 com leitura/escrita só nesse bucket.
MEDIA_PUBLIC_URL=https://media.zonasulurgente.com.br
MEDIA_S3_ENDPOINT=https://<id-da-conta>.r2.cloudflarestorage.com
MEDIA_S3_BUCKET=zsu-media
MEDIA_S3_ACCESS_KEY=
MEDIA_S3_SECRET_KEY=

# ---- IA ------------------------------------------------------------------------------------------------
# Chave do Google AI Studio (plano grátis: só conteúdo público vai para a IA).
GEMINI_API_KEY=

# ---- Cloudflare Tunnel ---------------------------------------------------------------------------------
# Token do túnel (Zero Trust → Networks → Tunnels → o túnel → "Install connector" → o valor depois de --token).
TUNNEL_TOKEN=
# Versão do cloudflared (vazio = latest). Fixe depois do primeiro deploy.
CLOUDFLARED_TAG=

# ---- Primeiro administrador ----------------------------------------------------------------------------
# Só no primeiro deploy (banco vazio): a API cria o convite e mostra o link no log (7 dias, uso único).
# Depois que o Admin entrar, pode apagar.
ZSU_BOOTSTRAP_ADMIN_EMAIL=
ZSU_BOOTSTRAP_ADMIN_NAME=
