# Copie para .env.local e ajuste. Nunca versione .env.local.

# URL pública do portal (canonical, OpenGraph, sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# URL da API Spring Boot, usada só no servidor Next (não exposta ao navegador).
API_URL=http://localhost:8080

# Segredo compartilhado com a API para POST /api/revalidate (mínimo 32 caracteres).
# Gere com: openssl rand -base64 32. Vazio = revalidação desligada (503).
REVALIDATE_SECRET=
