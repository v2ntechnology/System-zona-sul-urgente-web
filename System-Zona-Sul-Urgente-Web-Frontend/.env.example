# Copie para .env.local e ajuste. Nunca versione .env.local.

# URL pública do portal (canonical, OpenGraph, sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# URL da API Spring Boot, usada só no servidor Next (não exposta ao navegador).
# Vazio = o site usa os dados de exemplo (src/mocks), sem precisar do backend.
# Com a API local no ar (perfil "local"): API_URL=http://localhost:8080
API_URL=

# Segredo compartilhado com a API para POST /api/revalidate (mínimo 32 caracteres).
# Gere com: openssl rand -base64 32. Vazio = revalidação desligada (503).
REVALIDATE_SECRET=

# Link do canal/grupo de WhatsApp do jornal (opcional; vazio esconde o link).
NEXT_PUBLIC_WHATSAPP_URL=

# WhatsApp da redação para "Envie sua notícia" (padrão: número do site atual).
NEXT_PUBLIC_REPORT_WHATSAPP_URL=

# "production" libera o Google (robots.txt e meta robots). Qualquer outro valor bloqueia a
# indexação — use em local e staging. ATENÇÃO: sem esta variável em produção o site some do Google.
NEXT_PUBLIC_SITE_ENV=

# Painel /admin em produção (lido NO BUILD). Sem login (BE-006), deixe vazio: o painel responde 404.
# "true" só em ambiente protegido (ex.: staging atrás do Cloudflare Access).
ADMIN_PREVIEW=
