# Variáveis lidas pelo application.yml. Copie para .env (não versionado).
DB_URL=jdbc:postgresql://localhost:5432/zonasul
DB_USER=zonasul
DB_PASSWORD=zonasul
SPRING_PROFILES_ACTIVE=local

# Chave AES-256 (32 bytes em base64) que criptografa os segredos do 2FA no banco.
# Gere com: openssl rand -base64 32. Trocar a chave invalida os 2FA já cadastrados.
TOTP_ENCRYPTION_KEY=

# Revalidação do site após publicar/editar (BE-011): URL interna do Next e o mesmo
# REVALIDATE_SECRET do frontend (openssl rand -base64 32). Vazios = desligada.
SITE_REVALIDATE_URL=
REVALIDATE_SECRET=
